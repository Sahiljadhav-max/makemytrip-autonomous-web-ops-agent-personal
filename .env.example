# ============================================================
# MakeMyTrip Autonomous Web Ops Agent - environment template
# Copy this file to ".env" and fill in real values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac/Linux:           cp .env.example .env
# ".env" is git-ignored. NEVER commit real keys. This file has none.
# ============================================================

# ---- General ------------------------------------------------
APP_ENV=development              # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# Comma-separated list of frontend URLs allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# ---- Supabase (database + screenshot storage) ---------------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET: bypasses database security rules. Backend and worker ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Public key. Only the frontend needs it (see frontend/.env.example).
SUPABASE_ANON_KEY=
# Optional: direct Postgres connection string, used for migrations
DATABASE_URL=

# ---- LLM (provider-agnostic: swap with one line) ------------
LLM_PROVIDER=gemini              # gemini | groq
GEMINI_API_KEY=
# Model names change often. Pick one from your Google AI Studio list.
GEMINI_MODEL=
# Optional backup provider
GROQ_API_KEY=
GROQ_MODEL=

# ---- Browser worker (GitHub Actions) ------------------------
# Needed later, when the API starts worker runs. Leave blank for now.
GITHUB_TOKEN=
GITHUB_REPO=Sahiljadhav-max/makemytrip-autonomous-web-ops-agent-personal
GITHUB_WORKFLOW_FILE=browser-worker.yml
# Shared secret so only our GitHub cron job can trigger scheduled runs
CRON_SECRET=

# ---- Browser safety policy (guardrails) ---------------------
# Where our sandbox site lives (set after deploying it)
SANDBOX_BASE_URL=http://localhost:8080
# DOMAIN ALLOWLIST: the browser may ONLY visit these hosts.
ALLOWED_DOMAINS=localhost,127.0.0.1
MAX_REQUESTS_PER_MINUTE=30
MAX_STEPS_PER_RUN=40
RUN_TIMEOUT_SECONDS=300
MAX_RETRIES=2

# ---- Monitoring (optional) ----------------------------------
SENTRY_DSN=
